# Generate random values: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
CAG_ADMIN_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_24_CHARS
CAG_USER_KEY=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_24_CHARS
CAG_DB_PATH=/data/grid.sqlite3
CAG_INITIAL_DEMO_CREDITS=100
# Worker lease in seconds (5-3600); workers must heartbeat well within it.
CAG_LEASE_SECONDS=180
# Port only on local loopback by default. For other hosts: use SSH forwarding or a VPN-restricted host address.
# Setting this to 0.0.0.0 (or a specific LAN/VPN address) exposes EVERY endpoint beyond loopback.
# Never publish it to the internet without an HTTPS reverse proxy and reading docs/SECURITY.md.
CAG_BIND_IP=127.0.0.1
# Only operator-approved models, e.g. demo-model,qwen2.5-coder:1.5b
CAG_ALLOWED_MODELS=demo-model
# Per authenticated identity and coordinator process; 0 disables.
CAG_RATE_LIMIT_PER_MINUTE=120
# Queued jobs without a matching worker fail and are refunded after this many seconds (60-604800).
CAG_QUEUE_TIMEOUT_SECONDS=3600
# Background lease/queue cleanup interval; 0 disables (expiry then only runs on requests).
CAG_SWEEP_SECONDS=30
# Per source IP on the unauthenticated /api/enroll endpoint (headless devices with a single-use code); 0 disables.
CAG_ENROLL_IP_PER_MINUTE=5
# Self-registration of member accounts in the app: off | invite (needs a code from /api/admin/invites) | open
CAG_REGISTRATION=off
# Credits a new member starts with.
CAG_SIGNUP_CREDITS=20
# true = completed jobs credit the machine owner at once (unverified!); false = provisional until an admin settles.
CAG_AUTO_SETTLE=false
# Registrations per source address and hour.
CAG_REGISTER_PER_HOUR=10
# Active machines a member may register.
CAG_MAX_MACHINES_PER_MEMBER=5
