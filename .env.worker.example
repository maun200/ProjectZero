CAG_COORD_URL=http://127.0.0.1:8765
CAG_WORKER_TOKEN=REPLACE_WITH_TOKEN_RETURNED_BY_ADMIN
CAG_MODEL=demo-model
CAG_LLM_BACKEND=openai
CAG_LLM_URL=http://127.0.0.1:8080/v1/chat/completions
CAG_LLM_API_KEY=
CAG_WORKER_POLL_SECONDS=3
# Native Ollama: set CAG_LLM_BACKEND=ollama and CAG_LLM_URL=http://127.0.0.1:11434/api/chat
# Use only an already installed, operator-approved CAG_MODEL. No automatic downloads.
CAG_OLLAMA_NUM_CTX=1024
CAG_OLLAMA_NUM_THREAD=2
CAG_OLLAMA_MAX_OUTPUT_TOKENS=32
# Native adapter requests keep_alive=0, num_batch=32 and CPU inference by default.
# GPU layers for Ollama (0-999); set >0 only after the operator approved GPU use.
CAG_OLLAMA_NUM_GPU=0
# Heartbeat interval while a job runs (1-300 s); must be well below the coordinator's CAG_LEASE_SECONDS.
CAG_LEASE_HEARTBEAT_SECONDS=30
